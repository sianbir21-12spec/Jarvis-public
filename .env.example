# Server configuration
PORT=3000

# OmniRoute AI Gateway configuration
OMNIROUTE_BASE_URL=https://omnirouuter.zeabur.app
OMNIROUTE_API_KEY=YOUR_OMNIROUTE_API_KEY
OMNIROUTE_MODEL=SIAN

# Optional: use a different (e.g. faster/cheaper) model specifically for the
# Agent Mode computer-control loop, separate from regular chat. Must support
# tool/function calling AND vision (image_url content) via OmniRoute's
# catalog. Leave blank to just reuse OMNIROUTE_MODEL.
AGENT_MODEL=

# Optional: Gemini fallback for Electron speech-to-text (recommended)
GEMINI_API_KEY=
GEMINI_STT_MODEL=gemini-3.6-flash
OMNIROUTE_STT_MODEL=whisper-1
APP_URL=
