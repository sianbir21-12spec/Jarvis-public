{
  "name": "jarvis-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Futuristic personal AI assistant command center powered by OmniRoute.",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.cjs release",
    "lint": "tsc --noEmit",
    "electron:dev": "concurrently -k -n SERVER,ELECTRON -c cyan,magenta \"cross-env NODE_ENV=development npm run dev\" \"wait-on http://localhost:3000/api/health && cross-env NODE_ENV=development electron .\"",
    "electron:build": "npm run build && electron-builder",
    "electron:pack": "npm run build && electron-builder --dir",
    "dist": "npm run electron:build"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@nut-tree-fork/nut-js": "^4.2.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "node-window-manager": "^2.2.4",
    "playwright": "^1.48.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.3.9",
    "esbuild": "^0.25.0",
    "node-gyp": "^13.0.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.jarvis.desktop",
    "productName": "JARVIS",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build-resources"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/@nut-tree-fork/**",
      "node_modules/sharp/**",
      "node_modules/node-window-manager/**",
      "node_modules/playwright/**",
      "node_modules/playwright-core/**"
    ],
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "mac": {
      "icon": "build-resources/icon.icns",
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ],
      "darkModeSupport": true
    },
    "win": {
      "icon": "build-resources/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "icon": "build-resources/icon.png",
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    }
  }
}
